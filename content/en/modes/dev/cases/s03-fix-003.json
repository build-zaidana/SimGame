    "file": "shop/voucher.py",
    "starter": "def gets_voucher(total_spent):\n    return total_spent > 100000\n",
    "tests": [
      {
        "name": "big spender",
        "code": "assert gets_voucher(150000) == True"
      },
      {
        "name": "exactly at the limit",
        "code": "assert gets_voucher(100000) == True"
